- name: deduplicates semantically identical updates
  code: |-
    runCode(mockData);
    const bridge = windowStore['__consentEaseGtmBridge'];

    bridge.publish(validPayload(acceptAll));
    bridge.publish(validPayload({
      necessary: true, functional: true, analytics: true, marketing: true
    }));
    assertThat(updateCalls.length, 'identical status must be applied exactly once').isEqualTo(1);

    bridge.publish(validPayload(rejectAll));
    assertThat(updateCalls.length, 'a new unique status must be applied').isEqualTo(2);
- name: ignores payloads with a wrong protocol version, Site ID or shape
  code: |-
    runCode(mockData);
    const bridge = windowStore['__consentEaseGtmBridge'];

    bridge.publish({ protocolVersion: 2, publicId: mockData.publicId, consent: acceptAll });
    bridge.publish({ protocolVersion: 1, publicId: 'someOtherSite', consent: acceptAll });
    bridge.publish(null);
    bridge.publish({ protocolVersion: 1, publicId: mockData.publicId });

    assertThat(updateCalls.length).isEqualTo(0);
- name: applies a stored choice published by the banner after load
  code: |-
    runCode(mockData);
    // The banner owns the ce_consent_{publicId} wrapper ({ consent, expires });
    // it validates expiry itself and republishes the stored choice through the
    // bridge once its script has loaded. The template never reads storage.
    windowStore['__consentEaseGtmBridge'].publish(validPayload({
      necessary: true, functional: true, analytics: false, marketing: false
    }));

    assertThat(updateCalls.length).isEqualTo(1);
    assertThat(updateCalls[0].functionality_storage).isEqualTo('granted');
    assertThat(updateCalls[0].analytics_storage).isEqualTo('denied');
    assertThat(updateCalls[0].ad_storage).isEqualTo('denied');
- name: fails visibly on an invalid Site ID with path characters
  code: |-
    mockData.publicId = '../../etc/passwd';
    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
    assertThat(defaultCalls.length).isEqualTo(0);
    assertThat(injectCalls.length).isEqualTo(0);
- name: fails visibly on a too-short Site ID
  code: |-
