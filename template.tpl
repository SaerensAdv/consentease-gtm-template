    windowStore['__consentEaseGtmBridge'].publish(validPayload(rejectAll));

    assertThat(updateCalls.length).isEqualTo(1);
    assertThat(updateCalls[0].ad_storage).isEqualTo('denied');
    assertThat(updateCalls[0].ad_user_data).isEqualTo('denied');
    assertThat(updateCalls[0].ad_personalization).isEqualTo('denied');
    assertThat(updateCalls[0].analytics_storage).isEqualTo('denied');
    assertThat(updateCalls[0].functionality_storage).isEqualTo('denied');
    assertThat(updateCalls[0].personalization_storage).isEqualTo('denied');
    assertThat(updateCalls[0].security_storage).isEqualTo('granted');
