    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
    assertThat(defaultCalls.length, 'denied defaults stay in place on failure').isEqualTo(1);
- name: honors privacy settings and a custom wait_for_update
  code: |-
    mockData.ads_data_redaction = false;
    mockData.url_passthrough = false;
    mockData.wait_for_update = 1000;
    runCode(mockData);

    let redaction = null;
    let passthrough = null;
    for (let i = 0; i < gtagSetCalls.length; i++) {
      if (gtagSetCalls[i][0] === 'ads_data_redaction') redaction = gtagSetCalls[i][1];
      if (gtagSetCalls[i][0] === 'url_passthrough') passthrough = gtagSetCalls[i][1];
    }
    assertThat(redaction).isEqualTo(false);
    assertThat(passthrough).isEqualTo(false);
    assertThat(defaultCalls[0].wait_for_update).isEqualTo(1000);
- name: falls back to 500ms when wait_for_update is invalid
  code: |-
    mockData.wait_for_update = 'not-a-number';
    runCode(mockData);

    assertThat(defaultCalls.length).isEqualTo(1);
    assertThat(defaultCalls[0].wait_for_update).isEqualTo(500);
setup: |-
  const mockData = {
    publicId: 'abc123XYZ-_9',
    ads_data_redaction: true,
    url_passthrough: true,
    wait_for_update: 500
  };

  let defaultCalls = [];
  let updateCalls = [];
  let injectCalls = [];
  let gtagSetCalls = [];
  let ops = [];
  let windowStore = {};
  let failInjection = false;

  mock('setDefaultConsentState', (settings) => {
    ops.push('setDefaultConsentState');
    defaultCalls.push(settings);
  });
  mock('updateConsentState', (settings) => {
    ops.push('updateConsentState');
    updateCalls.push(settings);
  });
  mock('gtagSet', (key, value) => {
    gtagSetCalls.push([key, value]);
  });
  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    ops.push('injectScript');
    injectCalls.push(url);
    if (failInjection) {
      onFailure();
    } else {
      onSuccess();
    }
  });
  mock('setInWindow', (key, value, overrideExisting) => {
    ops.push('setInWindow:' + key);
    windowStore[key] = value;
    return true;
  });
  mock('copyFromWindow', (key) => {
    return windowStore[key];
  });

  const acceptAll = { necessary: true, functional: true, analytics: true, marketing: true };
  const rejectAll = { necessary: true, functional: false, analytics: false, marketing: false };
  const validPayload = (consent) => {
    return {
      protocolVersion: 1,
      publicId: mockData.publicId,
      eventId: 'test-event',
      source: 'consentease-banner',
      consent: consent
    };
  };


