scenarios:
- name: sets denied defaults exactly once and injects the real script URL
  code: |-
    runCode(mockData);

    assertThat(defaultCalls.length).isEqualTo(1);
    assertThat(defaultCalls[0].ad_storage).isEqualTo('denied');
    assertThat(defaultCalls[0].ad_user_data).isEqualTo('denied');
    assertThat(defaultCalls[0].ad_personalization).isEqualTo('denied');
    assertThat(defaultCalls[0].analytics_storage).isEqualTo('denied');
    assertThat(defaultCalls[0].functionality_storage).isEqualTo('denied');
    assertThat(defaultCalls[0].personalization_storage).isEqualTo('denied');
    assertThat(defaultCalls[0].security_storage).isEqualTo('granted');
    assertThat(defaultCalls[0].wait_for_update).isEqualTo(500);

    assertThat(injectCalls.length).isEqualTo(1);
    assertThat(injectCalls[0]).isEqualTo('https://consentease.io/api/consent/abc123XYZ-_9/script.js');
    assertApi('gtmOnSuccess').wasCalled();
- name: registers bridge protocol v1 before injecting the banner script
  code: |-
    runCode(mockData);

    const bridge = windowStore['__consentEaseGtmBridge'];
    assertThat(bridge.protocolVersion).isEqualTo(1);
    assertThat(bridge.publicId).isEqualTo(mockData.publicId);

    const info = windowStore['__consentEaseGtmBridgeInfo'];
    assertThat(info.protocolVersion).isEqualTo(1);
    assertThat(info.publicId).isEqualTo(mockData.publicId);

    assertThat(ops.indexOf('setInWindow:__consentEaseGtmBridge') < ops.indexOf('injectScript'), 'bridge must be registered before the banner script is injected').isEqualTo(true);
    assertApi('gtmOnSuccess').wasCalled();
- name: maps accept-all consent to all signals granted
  code: |-
    runCode(mockData);
    windowStore['__consentEaseGtmBridge'].publish(validPayload(acceptAll));

    assertThat(updateCalls.length).isEqualTo(1);
    assertThat(updateCalls[0].ad_storage).isEqualTo('granted');
    assertThat(updateCalls[0].ad_user_data).isEqualTo('granted');
    assertThat(updateCalls[0].ad_personalization).isEqualTo('granted');
    assertThat(updateCalls[0].analytics_storage).isEqualTo('granted');
    assertThat(updateCalls[0].functionality_storage).isEqualTo('granted');
    assertThat(updateCalls[0].personalization_storage).isEqualTo('granted');
    assertThat(updateCalls[0].security_storage).isEqualTo('granted');
