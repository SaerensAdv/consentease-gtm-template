    assertThat(defaultCalls.length).isEqualTo(0);
    assertThat(injectCalls.length).isEqualTo(0);
- name: skips duplicate initialization for the same site
  code: |-
    windowStore['__consentEaseGtmBridgeInfo'] = { protocolVersion: 1, publicId: mockData.publicId };
    runCode(mockData);

    assertThat(defaultCalls.length, 'defaults must not be sent a second time').isEqualTo(0);
    assertThat(injectCalls.length, 'the banner script must not be injected twice').isEqualTo(0);
    assertApi('gtmOnSuccess').wasCalled();
- name: refuses a second ConsentEase tag for a different site
