___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// ConsentEase CMP - Consent Mode v2 template (banner bridge protocol v1).
//
// Responsibilities (exactly once per page lifecycle):
//   1. Validate the configured ConsentEase Site ID (publicId).
//   2. Set denied-by-default Consent Mode v2 defaults (security_storage granted).
//   3. Register the versioned banner bridge on window BEFORE the banner loads.
//   4. Inject the real ConsentEase banner script for this publicId.
//   5. Apply consent updates published by the banner (stored + new choices),
//      deduplicated per semantically unique status.
//
// Storage note: the ce_consent_{publicId} wrapper ({ consent, expires }) is
// owned entirely by the ConsentEase banner. This template never reads cookies
// or localStorage; stored choices arrive through the bridge after the banner
// script loads and validates expiry itself.
//
// developer_id is intentionally NOT set: Google has not assigned a developer
// ID to ConsentEase yet. Do not add one until it is officially assigned.

const log = require('logToConsole');
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const gtagSet = require('gtagSet');
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const makeNumber = require('makeNumber');

const PROTOCOL_VERSION = 1;
const BRIDGE_GLOBAL = '__consentEaseGtmBridge';
const BRIDGE_INFO_GLOBAL = '__consentEaseGtmBridgeInfo';
const SCRIPT_ORIGIN = 'https://consentease.io';
const PUBLIC_ID_ALLOWED_CHARS =
  'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-';

const isValidPublicId = (value) => {
  if (typeof value !== 'string') return false;
  if (value.length < 6 || value.length > 64) return false;
  for (let i = 0; i < value.length; i++) {
    if (PUBLIC_ID_ALLOWED_CHARS.indexOf(value.charAt(i)) === -1) return false;
  }
  return true;
};

// Mapping contract (bridge protocol v1):
//   functional -> functionality_storage + personalization_storage
//   analytics  -> analytics_storage
//   marketing  -> ad_storage + ad_user_data + ad_personalization
//   security_storage is always granted.
const mapConsentToSignals = (consent) => {
  return {
    ad_storage: consent.marketing ? 'granted' : 'denied',
    ad_user_data: consent.marketing ? 'granted' : 'denied',
    ad_personalization: consent.marketing ? 'granted' : 'denied',
    analytics_storage: consent.analytics ? 'granted' : 'denied',
    functionality_storage: consent.functional ? 'granted' : 'denied',
    personalization_storage: consent.functional ? 'granted' : 'denied',
    security_storage: 'granted'
  };
};

const consentFingerprint = (consent) => {
  return 'v1:f=' + (consent.functional ? '1' : '0') +
    ':a=' + (consent.analytics ? '1' : '0') +
    ':m=' + (consent.marketing ? '1' : '0');
};

const publicId = data.publicId;

if (!isValidPublicId(publicId)) {
  log('ConsentEase GTM template: invalid Site ID (publicId). Use the exact value from your ConsentEase dashboard (letters, digits, "-" or "_", 6-64 characters).');
  data.gtmOnFailure();
} else {
  const existingInfo = copyFromWindow(BRIDGE_INFO_GLOBAL);
  if (existingInfo && existingInfo.protocolVersion === PROTOCOL_VERSION &&
      existingInfo.publicId === publicId) {
    // Duplicate load (second tag fire / second container) for the same site:
    // defaults were already set exactly once, the bridge is already live.
    log('ConsentEase GTM template: bridge already registered for this site; skipping duplicate initialization.');
    data.gtmOnSuccess();
  } else if (existingInfo) {
    // A ConsentEase bridge for a DIFFERENT site or protocol version is active.
    // Refuse loudly instead of sending Consent Mode defaults twice.
    log('ConsentEase GTM template: another ConsentEase bridge is already active on this page (different Site ID or protocol version). Remove the duplicate ConsentEase tag; refusing to initialize twice.');
    data.gtmOnFailure();
  } else {
    // Optional privacy behaviour, parity with the manual ConsentEase embed.
    gtagSet('ads_data_redaction', data.ads_data_redaction !== false);
    gtagSet('url_passthrough', data.url_passthrough !== false);

    let waitForUpdate = makeNumber(data.wait_for_update);
    if (waitForUpdate !== waitForUpdate || waitForUpdate < 0) {
      waitForUpdate = 500;
    }

    // Consent Mode v2 defaults: everything denied, security always granted.
    // Sent exactly once, BEFORE the banner script is injected.
    setDefaultConsentState({
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: waitForUpdate
    });

    let lastFingerprint = null;
    const bridge = {
      protocolVersion: PROTOCOL_VERSION,
      publicId: publicId,
      publish: (payload) => {
        if (!payload || payload.protocolVersion !== PROTOCOL_VERSION ||
            payload.publicId !== publicId || !payload.consent) {
          log('ConsentEase GTM template: ignored a bridge payload with an unexpected shape, Site ID or protocol version.');
          return;
        }
        const fingerprint = consentFingerprint(payload.consent);
        if (fingerprint === lastFingerprint) {
          // The semantically identical update was already applied exactly once.
          return;
        }
        lastFingerprint = fingerprint;
        updateConsentState(mapConsentToSignals(payload.consent));
      }
    };

    // Register the bridge BEFORE injecting the banner so the banner detects
    // GTM mode synchronously and never sends its own defaults or updates.
    setInWindow(BRIDGE_GLOBAL, bridge, true);
    setInWindow(BRIDGE_INFO_GLOBAL, {
      protocolVersion: PROTOCOL_VERSION,
      publicId: publicId
    }, true);

    const scriptUrl = SCRIPT_ORIGIN + '/api/consent/' + publicId + '/script.js';
    injectScript(scriptUrl, () => {
      data.gtmOnSuccess();
    }, () => {
      log('ConsentEase GTM template: failed to load the ConsentEase banner script from ' + scriptUrl + '. The page keeps the denied-by-default consent state.');
      data.gtmOnFailure();
    }, 'consentease-banner-' + publicId);
  }
}


